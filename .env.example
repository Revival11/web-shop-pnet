# ==========================================
# KONFIGURASI MIDTRANS (Ambil di Dashboard Midtrans -> Settings -> Access Keys)
# ==========================================
MIDTRANS_SERVER_KEY=SB-Mid-server-XXXXXXXXXXXXXXXXXXXXXXXX
MIDTRANS_CLIENT_KEY=SB-Mid-client-XXXXXXXXXXXXXXXXXXXXXXXX
MIDTRANS_IS_PRODUCTION=false

# ==========================================
# KONFIGURASI SERVER MINECRAFT (WAJIB AKTIF AGAR RANK/KIT/MONEY MASuk KE IN-GAME)
# ==========================================
MC_SERVER_HOST=mc.playnet.my.id
MC_BEDROCK_PORT=25523

# Ubah RCON_ENABLED menjadi true dan isi host/port/password sesuai server.properties Minecraft kamu!
RCON_ENABLED=true
RCON_HOST=216.163.186.75
RCON_PORT=12005
RCON_PASSWORD=password_rcon_server_kamu

# Template Command Server (Bisa disesuaikan dengan plugin LuckPerms / EssentialsX kamu)
RCON_RANK_CMD=lp user {player} parent add {item}
RCON_KIT_CMD=kit {item} {player}
RCON_MONEY_CMD=eco give {player} {amount}
